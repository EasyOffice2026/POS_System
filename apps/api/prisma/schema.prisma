// Database schema. Tables and columns use snake_case; models use PascalCase.
// Names that people read (brand, branch) are bilingual JSON: { "en": "...", "ar": "..." }.
// See docs/specs/001-auth-and-tenancy.md for how scoping and sign-in use these tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  GROUP
  BRAND
  BRANCH

  @@map("role_scope")
}

enum Language {
  en
  ar

  @@map("language")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      Json
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  // Brands are never deleted once they hold data. An inactive brand keeps its history.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches       Branch[]
  users          User[]
  menuCategories MenuCategory[]
  combos         Combo[]
  ingredients    Ingredient[]
  suppliers      Supplier[]
  promotions     Promotion[]
  customers      Customer[]

  @@map("brands")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  address   String?
  timezone  String   @default("Asia/Kuwait")
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand          Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  assignments    UserBranch[]
  menuOverrides  BranchMenuItem[]
  orders         Order[]
  orderCounters  OrderCounter[]
  shifts         Shift[]
  stock          BranchStock[]
  movements      StockMovement[]
  transfersOut   StockTransfer[]  @relation("transfersOut")
  transfersIn    StockTransfer[]  @relation("transfersIn")
  stockCounts    StockCount[]
  purchaseOrders PurchaseOrder[]
  tables         DiningTable[]

  // Lets tables that carry a brand id point at "this branch of this brand".
  @@unique([id, brandId])
  @@index([brandId])
  @@map("branches")
}

// Built-in roles. They are written from code at startup (packages/shared systemRoles).
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique
  name        String
  scope       RoleScope
  permissions Json

  users User[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  // Null for group-level users (Group Admin).
  brandId             String?   @map("brand_id") @db.Uuid
  roleId              String    @map("role_id") @db.Uuid
  name                String
  // Stored lower-case.
  email               String?   @unique
  passwordHash        String?   @map("password_hash")
  // Staff code and PIN are how branch staff sign in at a terminal.
  staffCode           String?   @map("staff_code")
  pinHash             String?   @map("pin_hash")
  preferredLang       Language  @default(en) @map("preferred_lang")
  isActive            Boolean   @default(true) @map("is_active")
  // Counts failed sign-ins in a row. Reset by a successful sign-in.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches      UserBranch[]
  refreshTokens RefreshToken[]

  @@unique([brandId, staffCode])
  @@index([brandId])
  @@map("users")
}

// Which branches a branch-scoped user works at.
model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  // Copy of the branch's brand, so rows can be filtered by brand like every other table.
  // The foreign key to the branch includes it, so it can never name another brand.
  brandId  String @map("brand_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@index([brandId])
  @@map("user_branches")
}

// One row per issued refresh token. Only the SHA-256 hash of the token is stored.
// Tokens rotate inside a family; reusing an old token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  // Set for PIN sessions, which are limited to the terminal's branch.
  branchId  String?   @map("branch_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Append-only record of sensitive actions. No foreign keys, so history outlives users.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String?  @map("brand_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([brandId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  // The whole log, newest first, as a group admin reads it.
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// The menu. It belongs to a brand, and a branch only stores differences (BranchMenuItem). Every
// table carries the brand, and each link to a parent includes it, so the database refuses a row
// that mixes two brands. Nothing in the menu is deleted: it is made inactive, so old orders keep
// their names and prices. Prices are numeric(10,3). See docs/specs/004-menu.md.

model MenuCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  // The kitchen station of the brand's settings its dishes go to (docs/specs/009-settings.md).
  stationId String?  @map("station_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  items MenuItem[]

  // Lets an item point at "this category of this brand".
  @@unique([id, brandId])
  @@index([brandId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        Json
  description Json?
  // Both names written plainly (see normalizeSearchText), English first. Searched, and sorted on.
  searchText  String   @default("") @map("search_text")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 3)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       MenuCategory      @relation(fields: [categoryId, brandId], references: [id, brandId], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  overrides      BranchMenuItem[]
  comboOptions   ComboSlotOption[]
  recipeLines    RecipeLine[]
  orderLines     OrderLine[]

  @@unique([id, brandId])
  @@index([brandId, categoryId])
  @@map("menu_items")
}

// What one branch changes about one item. A branch with no changes has no row.
model BranchMenuItem {
  branchId      String   @map("branch_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  // Null means the brand's price.
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 3)
  isAvailable   Boolean  @default(true) @map("is_available")
  // The days and times the item can be sold, in the shape of opening hours. Null means always.
  schedule      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch   @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  item   MenuItem @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([branchId, itemId])
  @@index([itemId])
  @@index([brandId])
  @@map("branch_menu_items")
}

model ModifierGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  name      Json
  // A minimum of 1 or more makes a choice required.
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item      MenuItem   @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)
  modifiers Modifier[]

  @@unique([id, brandId])
  @@index([itemId])
  @@map("modifier_groups")
}

model Modifier {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  name       Json
  // What the modifier adds to the price of the item. It can be 0 or below.
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(10, 3)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group       ModifierGroup @relation(fields: [groupId, brandId], references: [id, brandId], onDelete: Restrict)
  recipeLines RecipeLine[]

  @@unique([id, brandId])
  @@index([groupId])
  @@map("modifiers")
}

// A fixed price for a set of choices. Each slot is one choice, and its options are the items that
// can fill it.
model Combo {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  price     Decimal  @db.Decimal(10, 3)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  slots      ComboSlot[]
  orderLines OrderLine[]

  @@unique([id, brandId])
  @@index([brandId])
  @@map("combos")
}

model ComboSlot {
  id        String @id @default(uuid(7)) @db.Uuid
  brandId   String @map("brand_id") @db.Uuid
  comboId   String @map("combo_id") @db.Uuid
  name      Json
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo             @relation(fields: [comboId, brandId], references: [id, brandId], onDelete: Restrict)
  options ComboSlotOption[]

  @@unique([id, brandId])
  @@index([comboId])
  @@map("combo_slots")
}

model ComboSlotOption {
  slotId     String  @map("slot_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  brandId    String  @map("brand_id") @db.Uuid
  // What this choice adds to the price of the combo, for example a bigger drink.
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(10, 3)
  sortOrder  Int     @default(0) @map("sort_order")

  // The options go with their slot when a combo's slots are replaced.
  slot ComboSlot @relation(fields: [slotId, brandId], references: [id, brandId], onDelete: Cascade)
  item MenuItem  @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([slotId, itemId])
  @@index([itemId])
  @@map("combo_slot_options")
}

// ---- Orders. See docs/specs/005-orders.md.

enum OrderType {
  dine_in
  takeaway

  @@map("order_type")
}

enum OrderStatus {
  open
  paid
  voided

  @@map("order_status")
}

enum OrderLineKind {
  item
  combo

  @@map("order_line_kind")
}

enum OrderLineStatus {
  pending
  sent
  voided

  @@map("order_line_status")
}

enum DiscountKind {
  percent
  amount

  @@map("discount_kind")
}

// One order at a branch. People are stored by id only: users are never deleted, they are
// deactivated, like the audit log keeps them.
model Order {
  id                   String        @id @default(uuid(7)) @db.Uuid
  brandId              String        @map("brand_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  // The day on the branch's clock when the order was opened. Numbers count from 1 each day.
  businessDate         DateTime      @map("business_date") @db.Date
  number               Int
  type                 OrderType
  status               OrderStatus   @default(open)
  note                 String?
  subtotal             Decimal       @default(0) @db.Decimal(15, 3)
  // The code typed on the order, and what promotions took off (docs/specs/021-promotions.md).
  promoCode            String?       @map("promo_code")
  promotionDiscount    Decimal       @default(0) @map("promotion_discount") @db.Decimal(15, 3)
  promotions           Json          @default("[]")
  // The customer, the points spent and what they took off, and the points earned once paid
  // (docs/specs/022-loyalty.md).
  customerId           String?       @map("customer_id") @db.Uuid
  pointsRedeemed       Int           @default(0) @map("points_redeemed")
  pointsDiscount       Decimal       @default(0) @map("points_discount") @db.Decimal(15, 3)
  pointsEarned         Int           @default(0) @map("points_earned")
  // The table of a dine-in order (docs/specs/023-floor-plan.md). The open key equals the table
  // while the order is open and is null after, so a table holds one open order at most.
  tableId              String?       @map("table_id") @db.Uuid
  tableOpenKey         String?       @unique @map("table_open_key") @db.Uuid
  billPrintedAt        DateTime?     @map("bill_printed_at") @db.Timestamptz(3)
  discountKind         DiscountKind? @map("discount_kind")
  // The percentage or the amount that was given. The amount it takes off is worked out again
  // whenever the lines change.
  discountValue        Decimal?      @map("discount_value") @db.Decimal(12, 3)
  discountAmount       Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 3)
  discountReason       String?       @map("discount_reason")
  discountById         String?       @map("discount_by_id") @db.Uuid
  discountApprovedById String?       @map("discount_approved_by_id") @db.Uuid
  total                Decimal       @default(0) @db.Decimal(15, 3)
  // What was given back so far (docs/specs/011-refunds.md).
  refunded             Decimal       @default(0) @db.Decimal(15, 3)
  // Goes up with every change. Raising it first locks the row, so changes to one order happen one
  // after the other.
  version              Int           @default(0)
  openedById           String        @map("opened_by_id") @db.Uuid
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById           String?       @map("voided_by_id") @db.Uuid
  voidReason           String?       @map("void_reason")
  voidApprovedById     String?       @map("void_approved_by_id") @db.Uuid
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(3)
  paidById             String?       @map("paid_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch          @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  lines    OrderLine[]
  customer Customer?       @relation(fields: [customerId, brandId], references: [id, brandId], onDelete: Restrict)
  table    DiningTable?    @relation(fields: [tableId, branchId], references: [id, branchId], onDelete: Restrict)
  payments Payment[]
  tickets  KitchenTicket[]
  refunds  Refund[]

  @@unique([branchId, businessDate, number])
  // Lets a line point at "this order of this branch of this brand".
  @@unique([id, branchId, brandId])
  @@index([branchId, createdAt])
  // The open orders of a branch (the POS list and the dashboard) among all its history.
  @@index([branchId, status, createdAt])
  @@index([brandId, createdAt])
  @@map("orders")
}

// A dish or a combo on an order, with everything about it copied at the time it was added.
model OrderLine {
  id               String          @id @default(uuid(7)) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  brandId          String          @map("brand_id") @db.Uuid
  branchId         String          @map("branch_id") @db.Uuid
  kind             OrderLineKind
  itemId           String?         @map("item_id") @db.Uuid
  comboId          String?         @map("combo_id") @db.Uuid
  name             Json
  unitPrice        Decimal         @map("unit_price") @db.Decimal(12, 3)
  quantity         Int
  lineTotal        Decimal         @map("line_total") @db.Decimal(15, 3)
  // The chosen modifiers, or the combo choices with theirs, with names and prices.
  details          Json            @default("{}")
  note             String?
  status           OrderLineStatus @default(pending)
  position         Int
  // The kitchen ticket it was sent on (docs/specs/008-kitchen-display.md).
  ticketId         String?         @map("ticket_id") @db.Uuid
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(3)
  voidedAt         DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedById       String?         @map("voided_by_id") @db.Uuid
  voidReason       String?         @map("void_reason")
  voidApprovedById String?         @map("void_approved_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order          @relation(fields: [orderId, branchId, brandId], references: [id, branchId, brandId], onDelete: Restrict)
  item   MenuItem?      @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)
  combo  Combo?         @relation(fields: [comboId, brandId], references: [id, brandId], onDelete: Restrict)
  // The ticket belongs to the same order, so it is of the same branch and brand.
  ticket KitchenTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([orderId, position])
  @@index([ticketId])
  @@map("order_lines")
}

// The last order number given out at a branch on a business date.
model OrderCounter {
  branchId     String   @map("branch_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  brandId      String   @map("brand_id") @db.Uuid
  lastNumber   Int      @map("last_number")

  branch Branch @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([branchId, businessDate])
  @@map("order_counters")
}

// ---- Payments. See docs/specs/007-payments.md.

// One way an order was paid. The parts of one payment together pay the order's total exactly.
model Payment {
  // Made on the terminal, so a payment sent twice is taken once.
  id         String   @id @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  // Cash, or the key of a way to pay from the brand's settings (docs/specs/009-settings.md).
  method     String
  // The name of the way to pay as it was at the time.
  methodName Json     @default("{}") @map("method_name")
  // The part of the order it pays.
  amount     Decimal  @db.Decimal(15, 3)
  // Cash only: what the customer handed over, and the change given back.
  tendered   Decimal? @db.Decimal(15, 3)
  change     Decimal  @default(0) @db.Decimal(15, 3)
  // Card only: the slip number, when the cashier typed it.
  reference  String?
  // The shift of the person who took it (docs/specs/010-shifts.md). Null for payments taken
  // before shifts existed.
  shiftId    String?  @map("shift_id") @db.Uuid
  takenById  String   @map("taken_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order  @relation(fields: [orderId, branchId, brandId], references: [id, branchId, brandId], onDelete: Restrict)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([branchId, createdAt])
  @@index([shiftId])
  @@map("payments")
}

// ---- Kitchen display. See docs/specs/008-kitchen-display.md.

enum TicketStatus {
  new
  preparing
  ready
  done

  @@map("ticket_status")
}

// What one "send" of an order put in front of the kitchen.
model KitchenTicket {
  id        String       @id @default(uuid(7)) @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  brandId   String       @map("brand_id") @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  // The kitchen station of the brand's settings it is for, or null when the brand has none.
  stationId String?      @map("station_id") @db.Uuid
  status    TicketStatus @default(new)
  sentAt    DateTime     @map("sent_at") @db.Timestamptz(3)
  startedAt DateTime?    @map("started_at") @db.Timestamptz(3)
  readyAt   DateTime?    @map("ready_at") @db.Timestamptz(3)
  doneAt    DateTime?    @map("done_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order       @relation(fields: [orderId, branchId, brandId], references: [id, branchId, brandId], onDelete: Restrict)
  lines OrderLine[]

  @@index([branchId, status, sentAt])
  // The last finished tickets of a branch, newest first, without reading its whole history.
  @@index([branchId, status, doneAt])
  @@index([orderId])
  @@map("kitchen_tickets")
}

// ---- Shifts. See docs/specs/010-shifts.md.

enum ShiftStatus {
  open
  closed

  @@map("shift_status")
}

// A cashier's shift at a branch: the cash in the drawer when it opened, and the count at closing.
// The names are kept as they were, so a report reads the same after a person is renamed.
model Shift {
  id           String      @id @default(uuid(7)) @db.Uuid
  brandId      String      @map("brand_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  status       ShiftStatus @default(open)
  openedById   String      @map("opened_by_id") @db.Uuid
  openedByName String      @map("opened_by_name")
  openedAt     DateTime    @map("opened_at") @db.Timestamptz(3)
  openingCash  Decimal     @map("opening_cash") @db.Decimal(15, 3)
  closedById   String?     @map("closed_by_id") @db.Uuid
  closedByName String?     @map("closed_by_name")
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(3)
  countedCash  Decimal?    @map("counted_cash") @db.Decimal(15, 3)
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(15, 3)
  difference   Decimal?    @db.Decimal(15, 3)
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  payments Payment[]
  refunds  Refund[]

  @@index([branchId, status, openedAt])
  @@index([openedById, status])
  @@map("shifts")
}

// ---- Refunds. See docs/specs/011-refunds.md.

// Money given back for a paid order, in cash or by the way it was paid, with a manager's approval.
model Refund {
  // Made on the terminal, so a refund sent twice is given once.
  id           String   @id @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  shiftId      String   @map("shift_id") @db.Uuid
  amount       Decimal  @db.Decimal(15, 3)
  // Cash, or the key of the way the order was paid with, with its name at the time.
  method       String
  methodName   Json     @default("{}") @map("method_name")
  reason       String
  refundedById String   @map("refunded_by_id") @db.Uuid
  approvedById String?  @map("approved_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId, branchId, brandId], references: [id, branchId, brandId], onDelete: Restrict)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([shiftId])
  @@index([branchId, createdAt])
  @@map("refunds")
}

// ---- Inventory. See docs/specs/012-ingredients-and-stock.md.

enum StockUnit {
  g
  kg
  ml
  l
  piece

  @@map("stock_unit")
}

enum MovementKind {
  received
  adjustment
  waste
  sold
  transfer_in
  transfer_out
  count

  @@map("movement_kind")
}

// What a brand buys: flour, mozzarella, cola cans. Never deleted, only made inactive.
model Ingredient {
  id          String    @id @default(uuid(7)) @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  name        Json
  // Lower-cased names in both languages, for search, as menu items have.
  searchText  String    @map("search_text")
  unit        StockUnit
  costPerUnit Decimal   @default(0) @map("cost_per_unit") @db.Decimal(12, 3)
  // The brand's default: a branch is low at or below this.
  lowLevel    Decimal   @default(0) @map("low_level") @db.Decimal(15, 3)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  stock              BranchStock[]
  movements          StockMovement[]
  recipeLines        RecipeLine[]
  transferLines      StockTransferLine[]
  countLines         StockCountLine[]
  supplierPrices     SupplierPrice[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([id, brandId])
  @@index([brandId, isActive])
  @@map("ingredients")
}

// The stock of one ingredient at a branch, always the sum of its movements.
model BranchStock {
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(15, 3)
  // The branch's own low level, or null for the brand's default.
  lowLevel     Decimal? @map("low_level") @db.Decimal(15, 3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([branchId, ingredientId])
  @@map("branch_stock")
}

// Every change of a branch's stock, with the quantity after it.
model StockMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  brandId       String       @map("brand_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  ingredientId  String       @map("ingredient_id") @db.Uuid
  kind          MovementKind
  // Negative when stock leaves.
  quantity      Decimal      @db.Decimal(15, 3)
  quantityAfter Decimal      @map("quantity_after") @db.Decimal(15, 3)
  note          String?
  // The order or transfer it came from, later.
  referenceId   String?      @map("reference_id") @db.Uuid
  byId          String?      @map("by_id") @db.Uuid
  byName        String?      @map("by_name")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  branch     Branch     @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([branchId, ingredientId, createdAt])
  @@index([branchId, createdAt])
  @@map("stock_movements")
}

// ---- Recipes. See docs/specs/013-recipes.md.

// One ingredient of what a dish or a modifier uses, in the ingredient's unit.
model RecipeLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  brandId      String  @map("brand_id") @db.Uuid
  // One of the two: the dish, or the modifier.
  itemId       String? @map("item_id") @db.Uuid
  modifierId   String? @map("modifier_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(15, 3)

  item       MenuItem?  @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)
  modifier   Modifier?  @relation(fields: [modifierId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([itemId, ingredientId])
  @@unique([modifierId, ingredientId])
  @@index([brandId])
  @@map("recipe_lines")
}

// ---- Stock transfers. See docs/specs/014-stock-transfers.md.

enum TransferStatus {
  sent
  received
  cancelled

  @@map("transfer_status")
}

// Stock sent from one branch of a brand to another: off the sender when sent, onto the receiver
// when received, back to the sender when cancelled.
model StockTransfer {
  id              String         @id @default(uuid(7)) @db.Uuid
  number          Int            @default(autoincrement())
  brandId         String         @map("brand_id") @db.Uuid
  fromBranchId    String         @map("from_branch_id") @db.Uuid
  toBranchId      String         @map("to_branch_id") @db.Uuid
  status          TransferStatus @default(sent)
  note            String?
  sentById        String?        @map("sent_by_id") @db.Uuid
  sentByName      String?        @map("sent_by_name")
  sentAt          DateTime       @map("sent_at") @db.Timestamptz(3)
  receivedById    String?        @map("received_by_id") @db.Uuid
  receivedByName  String?        @map("received_by_name")
  receivedAt      DateTime?      @map("received_at") @db.Timestamptz(3)
  cancelledById   String?        @map("cancelled_by_id") @db.Uuid
  cancelledByName String?        @map("cancelled_by_name")
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?        @map("cancel_reason")

  fromBranch Branch              @relation("transfersOut", fields: [fromBranchId, brandId], references: [id, brandId], onDelete: Restrict)
  toBranch   Branch              @relation("transfersIn", fields: [toBranchId, brandId], references: [id, brandId], onDelete: Restrict)
  lines      StockTransferLine[]

  @@unique([id, brandId])
  @@index([fromBranchId, sentAt])
  @@index([toBranchId, sentAt])
  @@map("stock_transfers")
}

// One ingredient of a transfer, in the ingredient's unit.
model StockTransferLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  transferId   String  @map("transfer_id") @db.Uuid
  brandId      String  @map("brand_id") @db.Uuid
  // Copied from the transfer, so each branch reaches its own lines.
  fromBranchId String  @map("from_branch_id") @db.Uuid
  toBranchId   String  @map("to_branch_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(15, 3)

  transfer   StockTransfer @relation(fields: [transferId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient    @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([transferId, ingredientId])
  @@map("stock_transfer_lines")
}

// ---- Stock counts. See docs/specs/015-stock-counts.md.

enum CountStatus {
  open
  finished
  cancelled

  @@map("count_status")
}

// A check of a branch's stock against what is on the shelves.
model StockCount {
  id              String      @id @default(uuid(7)) @db.Uuid
  number          Int         @default(autoincrement())
  brandId         String      @map("brand_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  status          CountStatus @default(open)
  // The branch while the count is open, null after: one open count per branch (rule 1).
  openKey         String?     @unique @map("open_key") @db.Uuid
  note            String?
  startedById     String?     @map("started_by_id") @db.Uuid
  startedByName   String?     @map("started_by_name")
  startedAt       DateTime    @map("started_at") @db.Timestamptz(3)
  finishedById    String?     @map("finished_by_id") @db.Uuid
  finishedByName  String?     @map("finished_by_name")
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  cancelledById   String?     @map("cancelled_by_id") @db.Uuid
  cancelledByName String?     @map("cancelled_by_name")
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?     @map("cancel_reason")

  branch Branch           @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  lines  StockCountLine[]

  @@unique([id, brandId])
  @@index([branchId, startedAt])
  @@map("stock_counts")
}

// One ingredient of a count: what the system expected and what was counted.
model StockCountLine {
  id           String   @id @default(uuid(7)) @db.Uuid
  countId      String   @map("count_id") @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  expected     Decimal  @db.Decimal(15, 3)
  counted      Decimal? @db.Decimal(15, 3)
  // The cost of a unit when the count was finished, so the value of the difference stays.
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 3)

  count      StockCount @relation(fields: [countId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([countId, ingredientId])
  @@map("stock_count_lines")
}

// ---- Suppliers. See docs/specs/017-suppliers.md.

// Who a brand buys from.
model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  name        String
  // The name lower-cased, for search and to keep names unique in the brand.
  searchText  String   @map("search_text")
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  // The days given to pay; 0 is cash on delivery.
  paymentDays Int      @default(0) @map("payment_days")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  prices         SupplierPrice[]
  purchaseOrders PurchaseOrder[]

  @@unique([id, brandId])
  @@unique([brandId, searchText])
  @@map("suppliers")
}

// The price of one unit of an ingredient from a supplier.
model SupplierPrice {
  supplierId   String   @map("supplier_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  brandId      String   @map("brand_id") @db.Uuid
  price        Decimal  @db.Decimal(12, 3)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  supplier   Supplier   @relation(fields: [supplierId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([supplierId, ingredientId])
  @@map("supplier_prices")
}

// ---- Purchase orders. See docs/specs/018-purchase-orders.md.

enum PurchaseOrderStatus {
  draft
  sent
  received
  cancelled

  @@map("purchase_order_status")
}

// Ingredients ordered for a branch from a supplier.
model PurchaseOrder {
  id              String              @id @default(uuid(7)) @db.Uuid
  number          Int                 @default(autoincrement())
  brandId         String              @map("brand_id") @db.Uuid
  branchId        String              @map("branch_id") @db.Uuid
  supplierId      String              @map("supplier_id") @db.Uuid
  status          PurchaseOrderStatus @default(draft)
  expectedOn      DateTime?           @map("expected_on") @db.Date
  note            String?
  total           Decimal             @default(0) @db.Decimal(12, 3)
  createdById     String?             @map("created_by_id") @db.Uuid
  createdByName   String?             @map("created_by_name")
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sentById        String?             @map("sent_by_id") @db.Uuid
  sentByName      String?             @map("sent_by_name")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  cancelledById   String?             @map("cancelled_by_id") @db.Uuid
  cancelledByName String?             @map("cancelled_by_name")
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?             @map("cancel_reason")
  // Set when the goods are received (docs/specs/019-goods-receipt.md).
  receivedById    String?             @map("received_by_id") @db.Uuid
  receivedByName  String?             @map("received_by_name")
  receivedAt      DateTime?           @map("received_at") @db.Timestamptz(3)
  invoiceNumber   String?             @map("invoice_number")
  receiveNote     String?             @map("receive_note")
  receivedTotal   Decimal?            @map("received_total") @db.Decimal(12, 3)

  branch   Branch              @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  supplier Supplier            @relation(fields: [supplierId, brandId], references: [id, brandId], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@unique([id, brandId])
  @@index([branchId, createdAt])
  @@index([supplierId])
  @@map("purchase_orders")
}

// One ingredient of a purchase order, in the ingredient's unit.
model PurchaseOrderLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  quantity         Decimal  @db.Decimal(15, 3)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 3)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 3)
  // What arrived, at what price, once the order is received.
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(15, 3)
  receivedPrice    Decimal? @map("received_price") @db.Decimal(12, 3)
  receivedTotal    Decimal? @map("received_total") @db.Decimal(12, 3)

  order      PurchaseOrder @relation(fields: [orderId, brandId], references: [id, brandId], onDelete: Restrict)
  ingredient Ingredient    @relation(fields: [ingredientId, brandId], references: [id, brandId], onDelete: Restrict)

  @@unique([orderId, ingredientId])
  @@map("purchase_order_lines")
}

// ---- Promotions. See docs/specs/021-promotions.md.

enum PromotionKind {
  percent_off
  buy_get
  amount_off

  @@map("promotion_kind")
}

enum PromotionScope {
  all
  categories
  items

  @@map("promotion_scope")
}

// A discount the brand sets up once and the POS applies by itself.
model Promotion {
  id          String         @id @default(uuid(7)) @db.Uuid
  brandId     String         @map("brand_id") @db.Uuid
  name        Json
  kind        PromotionKind
  // A percentage (20.000) or an amount (1.000), or nothing for buy and get.
  value       Decimal?       @db.Decimal(12, 3)
  buyQuantity Int?           @map("buy_quantity")
  getQuantity Int?           @map("get_quantity")
  appliesTo   PromotionScope @default(all) @map("applies_to")
  categoryIds String[]       @default([]) @map("category_ids") @db.Uuid
  itemIds     String[]       @default([]) @map("item_ids") @db.Uuid
  // None means every branch.
  branchIds   String[]       @default([]) @map("branch_ids") @db.Uuid
  startsOn    DateTime?      @map("starts_on") @db.Date
  endsOn      DateTime?      @map("ends_on") @db.Date
  // 0 is Sunday; none means every day.
  days        Int[]          @default([])
  startTime   String?        @map("start_time")
  endTime     String?        @map("end_time")
  code        String?
  sortOrder   Int            @default(0) @map("sort_order")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, code])
  @@index([brandId, isActive])
  @@map("promotions")
}

// ---- Customers and loyalty points. See docs/specs/022-loyalty.md.

enum LoyaltyEntryKind {
  earn
  redeem
  adjust

  @@map("loyalty_entry_kind")
}

// A customer of a brand, the same at every branch, known by their phone.
model Customer {
  id          String    @id @default(uuid(7)) @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  // "+" and digits.
  phone       String
  name        String?
  email       String?
  notes       String?
  // The phone and the name lower-cased, for search.
  searchText  String    @map("search_text")
  points      Int       @default(0)
  visits      Int       @default(0)
  totalSpent  Decimal   @default(0) @map("total_spent") @db.Decimal(15, 3)
  lastVisitAt DateTime? @map("last_visit_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand   Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  entries LoyaltyEntry[]
  orders  Order[]

  @@unique([id, brandId])
  @@unique([brandId, phone])
  @@map("customers")
}

// Every change of a customer's points, with the balance after it.
model LoyaltyEntry {
  id           String           @id @default(uuid(7)) @db.Uuid
  brandId      String           @map("brand_id") @db.Uuid
  branchId     String?          @map("branch_id") @db.Uuid
  customerId   String           @map("customer_id") @db.Uuid
  kind         LoyaltyEntryKind
  // Negative when points go.
  points       Int
  balanceAfter Int              @map("balance_after")
  orderId      String?          @map("order_id") @db.Uuid
  note         String?
  byId         String?          @map("by_id") @db.Uuid
  byName       String?          @map("by_name")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("loyalty_entries")
}

enum TableShape {
  square
  round

  @@map("table_shape")
}

// A table of a branch on its floor plan: an area's grid of 24 by 16 cells, a place and a size in
// cells. See docs/specs/023-floor-plan.md.
model DiningTable {
  id        String     @id @default(uuid(7)) @db.Uuid
  brandId   String     @map("brand_id") @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  name      String
  // The name in small letters with single spaces, unique in the branch.
  nameKey   String     @map("name_key")
  area      String
  seats     Int
  shape     TableShape @default(square)
  x         Int
  y         Int
  width     Int        @default(1)
  height    Int        @default(1)
  isActive  Boolean    @default(true) @map("is_active")
  // Its place in the list of the plan.
  position  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch  @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  orders Order[]

  @@unique([branchId, nameKey])
  // Lets an order point at "this table of this branch".
  @@unique([id, branchId])
  @@index([brandId])
  @@map("dining_tables")
}
