// Database schema. Tables and columns use snake_case; models use PascalCase.
// Names that people read (brand, branch) are bilingual JSON: { "en": "...", "ar": "..." }.
// See docs/specs/001-auth-and-tenancy.md for how scoping and sign-in use these tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  GROUP
  BRAND
  BRANCH

  @@map("role_scope")
}

enum Language {
  en
  ar

  @@map("language")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      Json
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  // Brands are never deleted once they hold data. An inactive brand keeps its history.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches       Branch[]
  users          User[]
  menuCategories MenuCategory[]
  combos         Combo[]

  @@map("brands")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  address   String?
  timezone  String   @default("Asia/Riyadh")
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand         Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  assignments   UserBranch[]
  menuOverrides BranchMenuItem[]
  orders        Order[]
  orderCounters OrderCounter[]

  // Lets tables that carry a brand id point at "this branch of this brand".
  @@unique([id, brandId])
  @@index([brandId])
  @@map("branches")
}

// Built-in roles. They are written from code at startup (packages/shared systemRoles).
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique
  name        String
  scope       RoleScope
  permissions Json

  users User[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  // Null for group-level users (Group Admin).
  brandId             String?   @map("brand_id") @db.Uuid
  roleId              String    @map("role_id") @db.Uuid
  name                String
  // Stored lower-case.
  email               String?   @unique
  passwordHash        String?   @map("password_hash")
  // Staff code and PIN are how branch staff sign in at a terminal.
  staffCode           String?   @map("staff_code")
  pinHash             String?   @map("pin_hash")
  preferredLang       Language  @default(en) @map("preferred_lang")
  isActive            Boolean   @default(true) @map("is_active")
  // Counts failed sign-ins in a row. Reset by a successful sign-in.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches      UserBranch[]
  refreshTokens RefreshToken[]

  @@unique([brandId, staffCode])
  @@index([brandId])
  @@map("users")
}

// Which branches a branch-scoped user works at.
model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  // Copy of the branch's brand, so rows can be filtered by brand like every other table.
  // The foreign key to the branch includes it, so it can never name another brand.
  brandId  String @map("brand_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@index([brandId])
  @@map("user_branches")
}

// One row per issued refresh token. Only the SHA-256 hash of the token is stored.
// Tokens rotate inside a family; reusing an old token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  // Set for PIN sessions, which are limited to the terminal's branch.
  branchId  String?   @map("branch_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Append-only record of sensitive actions. No foreign keys, so history outlives users.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String?  @map("brand_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([brandId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// The menu. It belongs to a brand, and a branch only stores differences (BranchMenuItem). Every
// table carries the brand, and each link to a parent includes it, so the database refuses a row
// that mixes two brands. Nothing in the menu is deleted: it is made inactive, so old orders keep
// their names and prices. Prices are numeric(10,3). See docs/specs/004-menu.md.

model MenuCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  items MenuItem[]

  // Lets an item point at "this category of this brand".
  @@unique([id, brandId])
  @@index([brandId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        Json
  description Json?
  // Both names written plainly (see normalizeSearchText), English first. Searched, and sorted on.
  searchText  String   @default("") @map("search_text")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 3)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       MenuCategory      @relation(fields: [categoryId, brandId], references: [id, brandId], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  overrides      BranchMenuItem[]
  comboOptions   ComboSlotOption[]
  orderLines     OrderLine[]

  @@unique([id, brandId])
  @@index([brandId, categoryId])
  @@map("menu_items")
}

// What one branch changes about one item. A branch with no changes has no row.
model BranchMenuItem {
  branchId      String   @map("branch_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  brandId       String   @map("brand_id") @db.Uuid
  // Null means the brand's price.
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 3)
  isAvailable   Boolean  @default(true) @map("is_available")
  // The days and times the item can be sold, in the shape of opening hours. Null means always.
  schedule      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch   @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  item   MenuItem @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([branchId, itemId])
  @@index([itemId])
  @@index([brandId])
  @@map("branch_menu_items")
}

model ModifierGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  name      Json
  // A minimum of 1 or more makes a choice required.
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  item      MenuItem   @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)
  modifiers Modifier[]

  @@unique([id, brandId])
  @@index([itemId])
  @@map("modifier_groups")
}

model Modifier {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  name       Json
  // What the modifier adds to the price of the item. It can be 0 or below.
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(10, 3)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group ModifierGroup @relation(fields: [groupId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([groupId])
  @@map("modifiers")
}

// A fixed price for a set of choices. Each slot is one choice, and its options are the items that
// can fill it.
model Combo {
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      Json
  price     Decimal  @db.Decimal(10, 3)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  slots      ComboSlot[]
  orderLines OrderLine[]

  @@unique([id, brandId])
  @@index([brandId])
  @@map("combos")
}

model ComboSlot {
  id        String @id @default(uuid(7)) @db.Uuid
  brandId   String @map("brand_id") @db.Uuid
  comboId   String @map("combo_id") @db.Uuid
  name      Json
  sortOrder Int    @default(0) @map("sort_order")

  combo   Combo             @relation(fields: [comboId, brandId], references: [id, brandId], onDelete: Restrict)
  options ComboSlotOption[]

  @@unique([id, brandId])
  @@index([comboId])
  @@map("combo_slots")
}

model ComboSlotOption {
  slotId     String  @map("slot_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  brandId    String  @map("brand_id") @db.Uuid
  // What this choice adds to the price of the combo, for example a bigger drink.
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(10, 3)
  sortOrder  Int     @default(0) @map("sort_order")

  // The options go with their slot when a combo's slots are replaced.
  slot ComboSlot @relation(fields: [slotId, brandId], references: [id, brandId], onDelete: Cascade)
  item MenuItem  @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([slotId, itemId])
  @@index([itemId])
  @@map("combo_slot_options")
}

// ---- Orders. See docs/specs/005-orders.md.

enum OrderType {
  dine_in
  takeaway

  @@map("order_type")
}

enum OrderStatus {
  open
  voided

  @@map("order_status")
}

enum OrderLineKind {
  item
  combo

  @@map("order_line_kind")
}

enum OrderLineStatus {
  pending
  sent
  voided

  @@map("order_line_status")
}

enum DiscountKind {
  percent
  amount

  @@map("discount_kind")
}

// One order at a branch. People are stored by id only: users are never deleted, they are
// deactivated, like the audit log keeps them.
model Order {
  id                   String        @id @default(uuid(7)) @db.Uuid
  brandId              String        @map("brand_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  // The day on the branch's clock when the order was opened. Numbers count from 1 each day.
  businessDate         DateTime      @map("business_date") @db.Date
  number               Int
  type                 OrderType
  status               OrderStatus   @default(open)
  note                 String?
  subtotal             Decimal       @default(0) @db.Decimal(15, 3)
  discountKind         DiscountKind? @map("discount_kind")
  // The percentage or the amount that was given. The amount it takes off is worked out again
  // whenever the lines change.
  discountValue        Decimal?      @map("discount_value") @db.Decimal(12, 3)
  discountAmount       Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 3)
  discountReason       String?       @map("discount_reason")
  discountById         String?       @map("discount_by_id") @db.Uuid
  discountApprovedById String?       @map("discount_approved_by_id") @db.Uuid
  total                Decimal       @default(0) @db.Decimal(15, 3)
  // Goes up with every change. Raising it first locks the row, so changes to one order happen one
  // after the other.
  version              Int           @default(0)
  openedById           String        @map("opened_by_id") @db.Uuid
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById           String?       @map("voided_by_id") @db.Uuid
  voidReason           String?       @map("void_reason")
  voidApprovedById     String?       @map("void_approved_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch      @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)
  lines  OrderLine[]

  @@unique([branchId, businessDate, number])
  // Lets a line point at "this order of this branch of this brand".
  @@unique([id, branchId, brandId])
  @@index([branchId, createdAt])
  @@index([brandId, createdAt])
  @@map("orders")
}

// A dish or a combo on an order, with everything about it copied at the time it was added.
model OrderLine {
  id               String          @id @default(uuid(7)) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  brandId          String          @map("brand_id") @db.Uuid
  branchId         String          @map("branch_id") @db.Uuid
  kind             OrderLineKind
  itemId           String?         @map("item_id") @db.Uuid
  comboId          String?         @map("combo_id") @db.Uuid
  name             Json
  unitPrice        Decimal         @map("unit_price") @db.Decimal(12, 3)
  quantity         Int
  lineTotal        Decimal         @map("line_total") @db.Decimal(15, 3)
  // The chosen modifiers, or the combo choices with theirs, with names and prices.
  details          Json            @default("{}")
  note             String?
  status           OrderLineStatus @default(pending)
  position         Int
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(3)
  voidedAt         DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedById       String?         @map("voided_by_id") @db.Uuid
  voidReason       String?         @map("void_reason")
  voidApprovedById String?         @map("void_approved_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order     @relation(fields: [orderId, branchId, brandId], references: [id, branchId, brandId], onDelete: Restrict)
  item  MenuItem? @relation(fields: [itemId, brandId], references: [id, brandId], onDelete: Restrict)
  combo Combo?    @relation(fields: [comboId, brandId], references: [id, brandId], onDelete: Restrict)

  @@index([orderId, position])
  @@map("order_lines")
}

// The last order number given out at a branch on a business date.
model OrderCounter {
  branchId     String   @map("branch_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  brandId      String   @map("brand_id") @db.Uuid
  lastNumber   Int      @map("last_number")

  branch Branch @relation(fields: [branchId, brandId], references: [id, brandId], onDelete: Restrict)

  @@id([branchId, businessDate])
  @@map("order_counters")
}
