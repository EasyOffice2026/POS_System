# Copy this file to .env for local development. .env is never committed.
# Every value below is optional in development: the defaults are the ones shown.
# In production the API refuses to start without its own DATABASE_URL and JWT_ACCESS_SECRET.

# Docker Compose services (docker-compose.yml).
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos
POSTGRES_PORT=5432
REDIS_PORT=6379

# Service ports. The web dev server forwards /api to port 3000, so change API_PORT
# together with the proxy target in apps/web/vite.config.ts.
API_PORT=3000
PRINT_BRIDGE_PORT=3100

# Database connection for the API, migrations and tests. Tests use their own schema
# (pos_test) inside this database, so they never touch your development data.
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos

# A hosted PostgreSQL such as Supabase: use the "Session pooler" address from the Connect button of
# the project. schema=pos keeps the tables out of the schema that Supabase publishes through its
# REST API. See "With a hosted database" in the README.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=pos&sslmode=require&uselibpqcompat=true

# Secret that signs access tokens (at least 32 characters). Use a long random value in production.
JWT_ACCESS_SECRET=dev-only-access-token-secret-do-not-use-in-production

# How many reverse proxies sit in front of the API (0 for none). Needed for correct client IPs.
TRUST_PROXY=0

# How long (in seconds) the menu of a branch is kept in memory if nothing changes it. Every change
# to the menu clears it at once, so this is only a safety net.
MENU_CACHE_TTL_SECONDS=300
