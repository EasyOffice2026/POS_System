# Copy this file to .env for local development. .env is never committed.

# Docker Compose services (docker-compose.yml). These defaults also apply when .env is missing.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos
POSTGRES_PORT=5432
REDIS_PORT=6379

# Service ports. The web dev server forwards /api to port 3000, so change API_PORT
# together with the proxy target in apps/web/vite.config.ts.
API_PORT=3000
PRINT_BRIDGE_PORT=3100
